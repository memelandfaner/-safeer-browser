<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:focusable="true" android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- Large address field; secondary actions remain available in the menu. -->
    <LinearLayout
        android:id="@+id/mobileTopBar"
        android:layout_width="match_parent" android:layout_height="@dimen/browser_toolbar_height"
        android:layout_alignParentTop="true" android:background="@color/bg_primary"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingHorizontal="8dp" android:elevation="6dp">

        <Button android:id="@+id/btnHome"
            android:layout_width="48dp" android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_mobile_icon_button"
            android:text="⌂"
            android:textColor="@color/accent_cyan"
            android:textSize="22sp"
            android:padding="0dp"
            android:contentDescription="@string/btn_home"
            android:visibility="visible" />
        <LinearLayout
            android:id="@+id/omniboxContainer"
            android:layout_width="0dp" android:layout_height="@dimen/browser_address_height" android:layout_weight="1"
            android:background="@drawable/bg_mobile_omnibox" android:gravity="center_vertical"
            android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="4dp">
            <TextView android:id="@+id/tvSecurityLock"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginEnd="8dp" android:text="🔒"
                android:textColor="@color/security_green" android:textSize="14sp" />
            <EditText android:id="@+id/editUrl"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:background="@android:color/transparent" android:hint="@string/url_hint"
                android:imeOptions="actionGo|flagNoExtractUi" android:inputType="textUri"
                android:selectAllOnFocus="true"
                android:paddingVertical="0dp" android:singleLine="true"
                android:textColor="@color/text_primary" android:textColorHint="@color/text_dim"
                android:textSize="@dimen/browser_address_text" android:contentDescription="@string/url_hint" />
            <TextView android:id="@+id/btnClearUrl" android:focusable="true"
                android:layout_width="48dp" android:layout_height="48dp" android:gravity="center"
                android:text="✕" android:textColor="@color/text_secondary" android:textSize="18sp"
                android:visibility="gone" android:contentDescription="@string/btn_clear"
                android:background="@drawable/bg_mobile_icon_button" />
            <TextView android:id="@+id/btnSearchTrigger" android:focusable="true"
                android:layout_width="48dp" android:layout_height="48dp" android:gravity="center"
                android:text="→" android:textColor="@color/accent_cyan" android:textSize="24sp"
                android:visibility="gone" android:contentDescription="@string/btn_go"
                android:background="@drawable/bg_mobile_icon_button" />
        </LinearLayout>
        <Button android:id="@+id/btnReload" android:layout_width="48dp" android:layout_height="48dp" android:visibility="gone" android:text="↻" />
        <Button android:id="@+id/btnStar" android:layout_width="48dp" android:layout_height="48dp" android:visibility="gone" android:text="☆" />
        <Button android:id="@+id/btnAddTab" android:layout_width="48dp" android:layout_height="48dp" android:visibility="gone" android:text="+" />
        <Button android:id="@+id/btnTabCount"
            android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="4dp"
            android:background="@drawable/bg_mobile_tab_badge" android:text="1"
            android:textColor="@color/accent_cyan" android:textSize="16sp" android:textStyle="bold"
            android:padding="0dp" android:contentDescription="@string/tabs_title" />
        <Button android:id="@+id/btnMenu"
            android:layout_width="48dp" android:layout_height="48dp"
            android:background="@drawable/bg_mobile_icon_button" android:text="⋮"
            android:textColor="@color/text_primary" android:textSize="24sp" android:padding="0dp"
            android:contentDescription="@string/btn_menu" />
    </LinearLayout>

    <!-- Page Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/pageProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:layout_below="@id/mobileTopBar"
        android:progressDrawable="@color/accent_cyan"
        android:visibility="gone" />

    <!-- Main WebView Container -->
    <FrameLayout
        android:id="@+id/webViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/pageProgressBar"
        android:layout_alignParentBottom="true"
        android:background="@color/bg_pure_black" />

    <!-- Find In Page Bar (Optional overlay) -->
    <LinearLayout
        android:id="@+id/findInPageBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_below="@id/mobileTopBar"
        android:background="@color/bg_secondary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:visibility="gone"
        android:elevation="8dp">

        <EditText
            android:id="@+id/editFindText"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_mobile_omnibox"
            android:hint="Najdi na strani..."
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvFindMatches"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp"
            android:text="0/0" />

        <Button
            android:id="@+id/btnFindPrev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_mobile_icon_button"
            android:text="▲"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnFindNext"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_mobile_icon_button"
            android:text="▼"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnFindClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_mobile_icon_button"
            android:text="✕"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Tab Switcher Grid Overlay -->
    <RelativeLayout
        android:id="@+id/tabSwitcherOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_pure_black"
        android:visibility="gone"
        android:elevation="20dp">

        <!-- Header of Tab Switcher -->
        <LinearLayout
            android:id="@+id/tabSwitcherHeader"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_alignParentTop="true"
            android:background="@color/bg_primary"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/tvTabsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tabs_title"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnNewTabInSwitcher"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_mobile_omnibox"
                android:paddingHorizontal="14dp"
                android:text="@string/tabs_new_tab"
                android:textColor="@color/accent_cyan"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCloseTabsSwitcher" android:contentDescription="@string/btn_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_mobile_icon_button"
                android:text="✕"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Grid of Tabs -->
        <GridView
            android:id="@+id/tabsGridView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/tabSwitcherHeader"
            android:layout_above="@+id/tabSwitcherFooter"
            android:numColumns="@integer/tab_grid_columns"
            android:horizontalSpacing="12dp"
            android:verticalSpacing="12dp"
            android:padding="14dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <!-- Footer -->
        <LinearLayout
            android:id="@+id/tabSwitcherFooter"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_alignParentBottom="true"
            android:background="@color/bg_primary"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCloseAllTabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tabs_close_all"
                android:textColor="@color/danger_red"
                android:textSize="13sp"
                android:textStyle="bold"
                android:padding="8dp" />
        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>
