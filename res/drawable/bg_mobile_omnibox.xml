<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_omnibox_focus" />
            <stroke android:width="2dp" android:color="@color/border_omnibox_focus" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_omnibox" />
            <stroke android:width="1dp" android:color="@color/border_omnibox" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>
